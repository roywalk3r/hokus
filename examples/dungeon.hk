// dungeon.hk — a tiny deterministic crawl: classes, statics, closures.
// Fully deterministic (no clock/randomness) so native and WASM agree.

// No % operator in the language: mod-6 by repeated subtraction.
fun die(acc) {
    while (acc >= 6) acc = acc - 6;
    return 1 + acc;
}

fun digit(d) {
    if (d == 0) return "0"; if (d == 1) return "1";
    if (d == 2) return "2"; if (d == 3) return "3";
    if (d == 4) return "4"; if (d == 5) return "5";
    if (d == 6) return "6"; if (d == 7) return "7";
    if (d == 8) return "8"; return "9";
}

// int -> string without a % operator (tens by subtraction)
fun text(n) {
    if (n < 0) return "-" + text(0 - n);
    var tens = 0; var top = n;
    while (top >= 10) { top = top - 10; tens = tens + 1; }
    if (n >= 100) return "big";
    if (tens == 0) return digit(top);
    return digit(tens) + digit(top);
}

class Dice {
    static seed(start) {
        var acc = start;
        // each call advances the captured counter — our "random" die
        fun roll() {
            acc = acc + 29;
            while (acc >= 97) acc = acc - 97;
            return die(acc);
        }
        return roll;
    }
}

class Hero {
    static born(name, hp) {
        var h = Hero(name);
        h.hp = hp;
        return h;
    }
    init(name) { this.name = name; this.hp = 20; }
    describe() { return this.name + " (" + text(this.hp) + " hp)"; }
}

var d6 = Dice.seed(7);
var hero = Hero.born("Ada", 20);

var room = 1;
while (room <= 3) {
    var hit = d6() * 2;
    print "room " + text(room) + ": the goblin rolls " + text(hit);
    if (hit > 5) {
        hero.hp = hero.hp - hit;
        print hero.describe() + " takes it on the chin";
    } else {
        print hero.describe() + " parries";
    }
    room = room + 1;
}
if (hero.hp <= 0) {
    print hero.describe() + " falls in the dark";
} else {
    print hero.describe() + " limps out";
}
